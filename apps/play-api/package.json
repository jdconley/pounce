{
  "name": "@pounce/play-api",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "crosscheck:plan": "esbuild scripts/daily-crosscheck/plan.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/crosscheck-plan.mjs && node node_modules/.cache/crosscheck-plan.mjs",
    "vectors:box-fort": "esbuild scripts/box-fort-vectors.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/box-fort-vectors.mjs && node node_modules/.cache/box-fort-vectors.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "0.27.7",
    "miniflare": "catalog:",
    "qrcode-generator": "2.0.4",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "exports": {
    "./*": "./src/*.ts"
  }
}
