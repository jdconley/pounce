{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conleychaos-play-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-01",
  // The app reaches the API only through its custom domain.
  "workers_dev": false,
  "routes": [
    { "pattern": "play.conleychaos.com", "custom_domain": true }
  ],
  // The landing page's images and clip (scripts/build-site-media.mjs writes ./public). The Worker
  // answers every path first; only /static/* (images) and the two icon files are served straight
  // from ./public, so no file there can stand in for the API, an invite or privacy page, or
  // /.well-known/apple-app-site-association (tests/site-assets.test.ts holds this). The clip in
  // ./public/media goes through the Worker (ASSETS), which answers the byte-range requests
  // Safari needs to play it.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/static/*", "!/favicon.ico", "!/apple-touch-icon.png"]
  },
  // TOKEN_SECRET, APNS_KEY_P8, APNS_KEY_ID, SIWA_KEY_P8, SIWA_KEY_ID and the four
  // TWILIO_* secrets (Twilio Verify) and REPORTS_KEY (the owner's key for reading player reports)
  // are set by the deploy pipeline, never listed here.
  "vars": {
    "APNS_TEAM_ID": "B222J9J7B8",
    "APNS_TOPIC": "com.conleychaos.play",
    "APNS_HOST": "api.push.apple.com",
    "SIWA_CLIENT_ID": "com.conleychaos.play",
    // The App Store listing, "https://apps.apple.com/app/id<number>": the landing page's App Store
    // badge, /get, the invite pages' "Get the app" link and Safari's Smart App Banner. Empty until
    // the app is on the App Store; while empty there is no banner, and those links go to the
    // TestFlight beta below.
    "APP_STORE_URL": "",
    // The public TestFlight beta. Used only while APP_STORE_URL is empty: the landing page's
    // "Join the beta on TestFlight" button, /get (and so the page's QR code), and the invite
    // pages' "Get the app" link. Without either, the landing page says "Coming soon to the App
    // Store". It can stay once APP_STORE_URL is set; nothing uses it then.
    "TESTFLIGHT_URL": "https://testflight.apple.com/join/ABEeCJbe",
    // Shared streaks, table looks and Play again (daily habit §15 row 3), on since the app's
    // streak screens shipped (row 4).
    "STREAKS": "on",
    // Reminders, status pushes, Pounce and Messages links (daily habit §15 row 5), on since the
    // app's notification settings and Pounce sheet shipped (row 5, app half). Needs STREAKS.
    "NOTIFY": "on",
    // The live table, a Live Activity (daily habit §15 row 7). Needs NOTIFY. On with the PR that
    // ships the app half: nothing is sent until a device uploads a push-to-start token, and
    // turning it off stops every Live Activity push without an app build.
    "LIVE": "on",
    // Parent consent for kittens (daily habit §15 row 9). Needs NOTIFY. On at merge (consent
    // design D4): a kitten's device still gets nothing until a parent links it and types the
    // code Twilio Verify texts them, and that needs the Twilio secrets.
    "CONSENT": "on",
    // Your own streak, the trophy room and connections on accept (trophy room design §5). Needs
    // STREAKS. On with the PR that ships the app half; off, the server answers as before.
    "TROPHY": "on",
    // The bad connection indicator: heartbeats the room answers without waking, move ids so a
    // move sent again after a reconnect lands once, and each seat's connection quality. Apps
    // before it never see the new fields (unknown keys and message types are ignored); off, the
    // server answers as before.
    "LINK": "on",
    // Nudges: a player asks the one whose move it is to take it, in the app and (with NOTIFY) by
    // push. Apps before it never send `nudge` and ignore the new fields and message types; off,
    // the server answers as before.
    "NUDGE": "on",
    // The games rooms may be created for beyond Cat Tower: a comma-separated list of game ids
    // (src/games, e.g. "tiles"). Empty: Cat Tower only, and asking for any other game is refused,
    // as it always was. It stays empty until an app that can draw the tile game is in TestFlight:
    // apps before it never ask for another game, and are told a table of one doesn't exist. Local
    // dev turns it on in .dev.vars (see .dev.vars.example); tests set it themselves.
    "GAMES": "",
    // App updates (docs/superpowers/specs/2026-11-12-app-updates-design.md). The oldest app
    // version the server still supports, e.g. "1.1": an app below it is told to update, once the
    // App Store has a version at least that new. Empty: every version is supported, and nothing
    // changes for any app. Version 1.0 sends no version; it counts as "1.0" (design §6 says what
    // it then shows, and why to wait before setting this).
    "APP_MINIMUM": "",
    // The minimum is guarded: it turns nobody away until Apple's own lookup names a version at
    // least that new, so it can be set ahead of a release and starts by itself when the release
    // is live. APP_LATEST (below) does NOT satisfy the guard. To enforce a minimum without
    // waiting for Apple, add "APP_MINIMUM_FORCE": "on" as well, and only when that version
    // really can be downloaded: everyone below it is locked out until they update.
    //
    // Overrides the version apps are told is the newest, for the soft "a new Pounce is ready"
    // card only ("1.2"), or "off" to say nothing. Empty: what Apple's public lookup for the
    // app's id last said (asked in the background at most every six hours, never while a
    // request waits). Until the app is listed the lookup finds nothing, and no app is told a
    // newer version exists. It never enforces the minimum and no update push goes by it.
    "APP_LATEST": ""
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "DEVICES", "class_name": "DeviceIndex" },
      { "name": "PLAYERS", "class_name": "Player" },
      { "name": "IDENTITIES", "class_name": "Identities" },
      { "name": "PAIRS", "class_name": "Pair" },
      { "name": "LINKS", "class_name": "Links" },
      { "name": "CONSENTS", "class_name": "Consents" },
      { "name": "KITTENS", "class_name": "KittenIndex" },
      { "name": "LIMITS", "class_name": "Limiter" },
      { "name": "REPORTS", "class_name": "Reports" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom", "DeviceIndex"] },
    { "tag": "v2", "new_sqlite_classes": ["Player", "Identities"] },
    { "tag": "v3", "new_sqlite_classes": ["Pair"] },
    { "tag": "v4", "new_sqlite_classes": ["Links"] },
    { "tag": "v5", "new_sqlite_classes": ["Consents", "KittenIndex"] },
    { "tag": "v6", "new_sqlite_classes": ["Limiter", "Reports"] }
  ],
  // Invocation logs would record each request URL, which carries room codes.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
