{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conleychaos-play-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-01",
  // The app reaches the API only through its custom domain.
  "workers_dev": false,
  "routes": [
    { "pattern": "play.conleychaos.com", "custom_domain": true }
  ],
  // TOKEN_SECRET, APNS_KEY_P8, APNS_KEY_ID, SIWA_KEY_P8, SIWA_KEY_ID and the four
  // TWILIO_* secrets (Twilio Verify) are set by the deploy pipeline, never listed here.
  "vars": {
    "APNS_TEAM_ID": "B222J9J7B8",
    "APNS_TOPIC": "com.conleychaos.play",
    "APNS_HOST": "api.push.apple.com",
    "SIWA_CLIENT_ID": "com.conleychaos.play",
    // The App Store listing, "https://apps.apple.com/app/id<number>": the invite pages' "Get the
    // app" link and Safari's Smart App Banner. Empty until App Store Connect gives the app its
    // number (App Information, Apple ID); while empty there is no banner and no install link.
    "APP_STORE_URL": "",
    // Shared streaks, table looks and Play again (daily habit §15 row 3), on since the app's
    // streak screens shipped (row 4).
    "STREAKS": "on",
    // Reminders, status pushes, Pounce and Messages links (daily habit §15 row 5), on since the
    // app's notification settings and Pounce sheet shipped (row 5, app half). Needs STREAKS.
    "NOTIFY": "on",
    // The live table, a Live Activity (daily habit §15 row 7). Needs NOTIFY. On with the PR that
    // ships the app half: nothing is sent until a device uploads a push-to-start token, and
    // turning it off stops every Live Activity push without an app build.
    "LIVE": "on",
    // Parent consent for kittens (daily habit §15 row 9). Needs NOTIFY. On at merge (consent
    // design D4): a kitten's device still gets nothing until a parent links it and types the
    // code Twilio Verify texts them, and that needs the Twilio secrets.
    "CONSENT": "on",
    // Your own streak, the trophy room and connections on accept (trophy room design §5). Needs
    // STREAKS. On with the PR that ships the app half; off, the server answers as before.
    "TROPHY": "on",
    // The bad connection indicator: heartbeats the room answers without waking, move ids so a
    // move sent again after a reconnect lands once, and each seat's connection quality. Apps
    // before it never see the new fields (unknown keys and message types are ignored); off, the
    // server answers as before.
    "LINK": "on",
    // Nudges: a player asks the one whose move it is to take it, in the app and (with NOTIFY) by
    // push. Apps before it never send `nudge` and ignore the new fields and message types; off,
    // the server answers as before.
    "NUDGE": "on"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "DEVICES", "class_name": "DeviceIndex" },
      { "name": "PLAYERS", "class_name": "Player" },
      { "name": "IDENTITIES", "class_name": "Identities" },
      { "name": "PAIRS", "class_name": "Pair" },
      { "name": "LINKS", "class_name": "Links" },
      { "name": "CONSENTS", "class_name": "Consents" },
      { "name": "KITTENS", "class_name": "KittenIndex" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom", "DeviceIndex"] },
    { "tag": "v2", "new_sqlite_classes": ["Player", "Identities"] },
    { "tag": "v3", "new_sqlite_classes": ["Pair"] },
    { "tag": "v4", "new_sqlite_classes": ["Links"] },
    { "tag": "v5", "new_sqlite_classes": ["Consents", "KittenIndex"] }
  ],
  // Invocation logs would record each request URL, which carries room codes.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
